@model baiTaplAnNinh.Models.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Product.Name;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/ChiTietSanPham.css"
          asp-append-version="true" />

    <style>
        .comment-section {
            margin: 48px 0;
            padding: 28px;
            border: 1px solid #f3d4e0;
            border-radius: 16px;
            background: #fff;
        }

        .comment-form {
            display: grid;
            gap: 12px;
            max-width: 700px;
            margin: 20px 0 32px;
        }

        .comment-form input,
        .comment-form textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #e6c5d2;
            border-radius: 8px;
            font: inherit;
        }

        .comment-form button {
            width: fit-content;
            padding: 12px 22px;
            border: none;
            border-radius: 24px;
            background: #d9457c;
            color: white;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .comment-item {
            margin-top: 16px;
            padding: 16px;
            border-bottom: 1px solid #f3d4e0;
        }

        .comment-content {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .comment-message {
            margin: 12px 0;
            padding: 12px;
            border-radius: 8px;
            background: #fff1f6;
            color: #8d2853;
        }

        .comment-date {
            color: #777;
            font-size: 13px;
        }
    </style>
}

<div class="container product-page">

    <!-- THÔNG TIN BÁNH -->
    <section class="chi_tiet_san_pham">

        <div class="khung_anh_banh">
            <img class="anh_banh_chinh"
                 src="@Url.Content("~/" + Model.Product.ImageUrl)"
                 alt="@Model.Product.Name" />
        </div>

        <div class="noi_dung_banh">

            <h2 class="loai_banh">
                @Model.Product.Category
            </h2>

            <h1 class="ten_banh_chi_tiet">
                @Model.Product.Name
            </h1>

            <p class="mo_ta_banh">
                @Model.Product.Description
            </p>

            <p class="gia_banh">
                @Model.Product.Price.ToString("N0")đ
            </p>

            <div class="hanh_dong_mua_hang">
                <a asp-controller="Products"
                   asp-action="Index">
                    <i class="fa-solid fa-arrow-left"></i>
                    Tiếp tục mua sắm
                </a>
            </div>

        </div>
    </section>

    <!-- BÌNH LUẬN -->
    <section class="comment-section">

        <h2>Đánh giá và bình luận</h2>

        <p>
            Chia sẻ cảm nhận của bạn về
            @Model.Product.Name.
        </p>

        @if (TempData["CommentSuccess"] != null)
        {
            <div class="comment-message" role="status">
                @TempData["CommentSuccess"]
            </div>
        }

        @if (TempData["CommentError"] != null)
        {
            <div class="comment-message" role="alert">
                @TempData["CommentError"]
            </div>
        }

        <form asp-controller="Products"
              asp-action="AddComment"
              method="post"
              class="comment-form">

            <input type="hidden"
                   name="productId"
                   value="@Model.Product.Id" />

            <div>
                <label for="userName">Tên của bạn</label>
                <input type="text"
                       id="userName"
                       name="userName"
                       maxlength="50"
                       required />
            </div>

            <div>
                <label for="content">Nội dung bình luận</label>
                <textarea id="content"
                          name="content"
                          rows="4"
                          maxlength="1000"
                          required></textarea>
            </div>

            <button type="submit">
                <i class="fa-solid fa-paper-plane"></i>
                Gửi bình luận
            </button>
        </form>

        <h3>
            Bình luận (@Model.Comments.Count)
        </h3>

        @if (Model.Comments.Count == 0)
        {
            <p>Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ!</p>
        }
        else
        {
            @foreach (var comment in Model.Comments)
            {
                <article class="comment-item">

                    <strong>@comment.UserName</strong>

                    <span class="comment-date">
                        @comment.CreatedAt.ToLocalTime()
                        .ToString("dd/MM/yyyy HH:mm")
                    </span>

                    <p class="comment-content">@comment.Content</p>

                </article>
            }
        }

    </section>

    <!-- BÁNH GỢI Ý -->
    @if (Model.RecommendedProducts.Count > 0)
    {
        <section class="goi-y-san-pham">

            <div class="goi-y-header">
                <h2>CÓ LẼ BẠN CŨNG SẼ THÍCH</h2>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="nut-xem-them">
                    Xem thêm
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="danh-sach-goi-y">

                @foreach (var item in Model.RecommendedProducts)
                {
                    <article class="the_san_pham goi_y_card">

                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@item.Id">

                            <img src="@Url.Content("~/" + item.ImageUrl)"
                                 alt="@item.Name"
                                 loading="lazy" />
                        </a>

                        <p class="ten_banh">@item.Name</p>

                        <p>@item.Price.ToString("N0")đ</p>

                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Xem bánh
                        </a>

                    </article>
                }

            </div>
        </section>
    }

</div>
